project                    = "attendance-service"
env                        = "dev"
owner                      = "devops-team"
region                     = "us-east-1"
base_domain                = "example.com"
service_subdomain          = "attendance"
enable_dns_records         = true
enable_health_checks       = true
enable_health_check_alarms = true
alarm_topic_name           = "attendance-service-dev-use1-alarms"
enable_dashboard           = true
dashboard_name             = "attendance-service-dev"
regions = [
  { region = "us-east-1", name_prefix = "attendance-service-dev-use1" },
  { region = "us-east-2", name_prefix = "attendance-service-dev-use2" },
]
